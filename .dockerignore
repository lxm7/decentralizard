# Dev tools
.git
.github
.editorconfig
.gitattributes
.node-version
.vscode
.husky
.claude
.gitlab-ci.yml

# Build outputs — never copy local build artefacts into the image
node_modules
.next
out
tsconfig.tsbuildinfo

# Tests / coverage — not needed to build or run the image
__tests__
coverage
jest.config.ts
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Local skill state
graphify-out

# User uploads — served from a volume/object store, never baked in
public/media

# Env files — never bake secrets into the image
.env*
.envrc

# Infra / docs — not needed in the container
infra
docs

# Docker files
.dockerignore*
Dockerfile*
docker-compose*.yml

# yarn
.yarn/cache
.yarn/unplugged
!.yarn/releases/yarn-4.7.0.cjs

# Readme
README.md

# Nginx config
nginx

# Certificates
certs
!certs/prod-ca-2021.crt