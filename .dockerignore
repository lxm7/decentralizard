# Dev tools
.git
.github
.editorconfig
.gitattributes
.node-version

# Build outputs — never copy local build artefacts into the image
node_modules
.next
out

# Env files — never bake secrets into the image
.env*
.envrc

# Infra / docs — not needed in the container
infra
docs

# Docker files
.dockerignore*
Dockerfile*
docker-compose*.yml

# yarn
.yarn/cache
.yarn/unplugged
!.yarn/releases/yarn-4.7.0.cjs

# Readme
README.md

# Nginx config
nginx

# Certificates
certs
!certs/prod-ca-2021.crt