# syntax=docker/dockerfile:1.7
# Multi-arch (amd64 + arm64) image for the container pipeline:
# built once in CI, runs on Hetzner CAX11 ARM (Tier 1, always-on) and EKS (Tier 2, demo).

ARG NODE_VERSION=20.16.0

FROM node:${NODE_VERSION}-bookworm-slim AS base
RUN corepack enable
WORKDIR /app

# --- Stage 1: install all deps (layer cached on yarn.lock) ---
FROM base AS deps
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases ./.yarn/releases
RUN YARN_ENABLE_IMMUTABLE_INSTALLS=1 yarn install --immutable

# --- Stage 2: build the Next.js / Payload app ---
FROM deps AS builder
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN yarn build

# --- Stage 3: prune to production-only deps ---
FROM deps AS prod-deps
RUN YARN_ENABLE_IMMUTABLE_INSTALLS=1 yarn workspaces focus --production

# --- Stage 4: runtime ---
FROM base AS production
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    CERT_CA=certs/prod-ca-2021.crt

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1001 nodejs \
    && useradd --uid 1001 --gid nodejs --create-home --shell /bin/bash nextjs

COPY --from=prod-deps --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder   --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder   --chown=nextjs:nodejs /app/public ./public
COPY --from=builder   --chown=nextjs:nodejs /app/package.json /app/yarn.lock /app/.yarnrc.yml ./
COPY --from=builder   --chown=nextjs:nodejs /app/.yarn ./.yarn
# Public Supabase CA for Postgres TLS — committed to the repo, not a secret
COPY --from=builder   --chown=nextjs:nodejs /app/certs/prod-ca-2021.crt ./certs/prod-ca-2021.crt

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:3000/api/health || exit 1

CMD ["yarn", "start"]
