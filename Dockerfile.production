# syntax=docker/dockerfile:1.7
# Multi-arch (amd64 + arm64) image for the container pipeline.
# deps + builder are pinned to $BUILDPLATFORM so yarn build always runs natively.
# Only the production stage uses $TARGETPLATFORM (for arch-specific native modules).

ARG NODE_VERSION=20.16.0

# base: always on build host — no QEMU for the expensive stages
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-bookworm-slim AS base
RUN corepack enable
WORKDIR /app

# --- Stage 1: install all deps (build host, layer cached on yarn.lock) ---
FROM base AS deps
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases ./.yarn/releases
RUN YARN_ENABLE_IMMUTABLE_INSTALLS=1 yarn install --immutable

# --- Stage 2: build Next.js / Payload (build host, native speed) ---
FROM base AS builder
ENV NEXT_TELEMETRY_DISABLED=1 \
    CERT_CA=certs/prod-ca-2021.crt
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Build-time secrets via BuildKit mounts — not written to image layers or the
# exported registry build cache (unlike ARG/ENV, which leak via the :buildcache image).
RUN --mount=type=secret,id=database_uri \
    --mount=type=secret,id=payload_secret \
    DATABASE_URI="$(cat /run/secrets/database_uri)" \
    PAYLOAD_SECRET="$(cat /run/secrets/payload_secret)" \
    yarn build

# --- Stage 3: runtime ($TARGETPLATFORM — arm64 or amd64) ---
# Next.js standalone output: the app server and its traced node_modules come
# from the builder, so there is NO yarn install here (kills the QEMU-emulated
# arm64 install that dominated build time). Only sharp's native binary is
# re-laid per-arch below.
FROM node:${NODE_VERSION}-bookworm-slim AS production
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    CERT_CA=certs/prod-ca-2021.crt

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1001 nodejs \
    && useradd --uid 1001 --gid nodejs --create-home --shell /bin/bash nextjs

# Standalone server + traced deps, then the static assets it does not bundle.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
# Public Supabase CA for Postgres TLS — committed to the repo, not a secret
COPY --from=builder --chown=nextjs:nodejs /app/certs/prod-ca-2021.crt ./certs/prod-ca-2021.crt

# sharp ships an arch-specific prebuilt binary; the standalone trace carries the
# build-host (amd64) one. Rebuild sharp for $TARGETPLATFORM in an isolated dir
# (prebuilt @img/* packages — download only, no compile) and overlay it onto the
# traced tree, so image optimization works on arm64 (Hetzner Tier 1) and amd64
# (EKS Tier 2) alike. Isolation keeps npm from reconciling the standalone's
# package.json against its (intentionally partial) traced node_modules.
RUN --mount=type=cache,target=/root/.npm \
    mkdir -p /tmp/sharp && cd /tmp/sharp \
    && npm init -y >/dev/null 2>&1 \
    && npm install --no-save --no-audit --no-fund sharp@0.34.5 \
    && rm -rf /app/node_modules/sharp /app/node_modules/@img \
    && cp -a /tmp/sharp/node_modules/. /app/node_modules/ \
    && chown -R nextjs:nodejs /app/node_modules/sharp /app/node_modules/@img \
    && rm -rf /tmp/sharp

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:3000/api/health || exit 1

CMD ["node", "server.js"]
